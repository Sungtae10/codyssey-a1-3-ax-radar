# 사용법
# 1) 이 파일을 복사해서 ".env" 로 저장합니다.
#    Windows PowerShell : Copy-Item .env.example .env
#    macOS / Linux      : cp .env.example .env
# 2) 아래 API 키 중 가지고 있는 것 "하나만" 채우면 됩니다. (추천: Gemini, 무료 등급 있음)
# 3) ".env" 는 .gitignore 에 들어 있어서 GitHub 에 올라가지 않습니다.
#    Vercel 에 배포할 때는 이 파일을 쓰지 않고, Vercel 대시보드의
#    Settings > Environment Variables 에 같은 이름으로 넣습니다.
# 4) 값 앞뒤에 따옴표나 공백을 넣지 않습니다.  예) GEMINI_API_KEY=AIza...

GEMINI_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# (선택) 키를 여러 개 넣었을 때 쓸 제공자: gemini | anthropic | openai
# 비워 두면 gemini > anthropic > openai 순서로 키가 있는 것을 씁니다.
# LLM_PROVIDER=gemini

# (선택) 모델 이름을 바꾸고 싶을 때만 적습니다. 비워 두면 아래 기본값을 씁니다.
# GEMINI_MODEL=gemini-3.5-flash-lite
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# OPENAI_MODEL=gpt-5.4-mini

# (선택) AI 응답을 기다리는 최대 시간(초). vercel.json 의 maxDuration(60초)보다 작게 둡니다.
# AI_TIMEOUT_SECONDS=40

# (선택) 같은 IP 가 1분에 요청할 수 있는 AI 진단 횟수. 0 이면 제한 없음. 기본 6
# RATE_LIMIT_PER_MINUTE=6

# (선택) OpenAI GPT-5 계열의 추론 강도: none | minimal | low | medium | high  (기본 low)
# OPENAI_REASONING_EFFORT=low

# (선택, 보너스 기능) 진단이 끝날 때마다 요약을 받을 웹훅 주소 (https 로 시작)
# Discord 채널 웹훅 또는 Make / Zapier 웹훅 주소를 넣으면 됩니다.
# NOTIFY_WEBHOOK_URL=
